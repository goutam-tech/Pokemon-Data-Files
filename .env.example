# =============================================================================
# Environment Configuration - Pokemon Data Files
# =============================================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# Never commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Local Database Credentials
# -----------------------------------------------------------------------------
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_local_db_password
DB_HOST=localhost
DB_PORT=5432

# -----------------------------------------------------------------------------
# Cloud Database Credentials (e.g., Render, Supabase, Neon)
# -----------------------------------------------------------------------------
DB_NAME_CLOUD=your_cloud_db_name
DB_USER_CLOUD=your_cloud_db_user
DB_PASSWORD_CLOUD=your_cloud_db_password
DB_HOST_CLOUD=your_cloud_db_host
DB_PORT_CLOUD=5432

# -----------------------------------------------------------------------------
# CSV File Paths
# -----------------------------------------------------------------------------
# Use absolute paths or paths relative to project root.
# Windows: C:\path\to\project\DB_Create\report\CSV\filename.csv
# Linux/Mac: /path/to/project/DB_Create/report/CSV/filename.csv
# -----------------------------------------------------------------------------
CSV_PATH_CATEGORIES=DB_Create/report/CSV/Categories.csv
CSV_PATH_COUNTRY=DB_Create/report/CSV/Country.csv
CSV_PATH_OWNERS=DB_Create/report/CSV/Owner.csv
CSV_PATH_POKEMON=DB_Create/report/CSV/Pokemon.csv
CSV_PATH_POKEMON_CATEGORY=DB_Create/report/CSV/PokemonCategory.csv
CSV_PATH_POKEMON_OWNER=DB_Create/report/CSV/PokemonOwner.csv
CSV_PATH_REVIEWS=DB_Create/report/CSV/Review.csv
CSV_PATH_REVIEWER=DB_Create/report/CSV/Reviewer.csv
CSV_PATH_REVIEWER_REVIEW=DB_Create/report/CSV/ReviewerReview.csv
